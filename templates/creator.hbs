<section class="stn-creator-body">
    <header class="stn-creator-head">
        <ol class="stn-steps">
            {{#each steps}}
            <li class="{{#if active}}active{{/if}} {{#if done}}done{{/if}} {{#if locked}}locked{{/if}}">
                <button type="button" data-action="step" data-step="{{id}}" {{#if locked}}disabled{{/if}}>{{label}}</button>
            </li>
            {{/each}}
        </ol>
        <div class="stn-points {{#if points.over}}over{{/if}}">
            <span class="label">{{localize "STN.Creator.points"}}</span>
            <span class="pips">{{#each points.pips}}<i class="pip {{#if filled}}filled{{/if}}"></i>{{/each}}</span>
            <strong>{{points.remaining}} / {{points.budget}}</strong>
        </div>
    </header>

    <div class="stn-step-body">
        {{!-- ------------------------------------------------ CLASS --}}
        {{#if (eq step "class")}}
        <h2>{{localize "STN.Creator.chooseClass"}}</h2>
        <p class="hint">{{localize "STN.Creator.chooseClassHint"}}</p>
        {{#each groups}}
        <div class="stn-group">
            <h3>{{name}} <small>{{note}}</small></h3>
            <div class="stn-cards">
                {{#each classes}}
                <button type="button" class="stn-card-btn {{#if selected}}selected{{/if}}" data-action="pickClass" data-class="{{key}}">
                    <strong>{{name}}</strong>
                    <span>{{summary}}</span>
                </button>
                {{/each}}
            </div>
        </div>
        {{/each}}

        {{#if classInfo}}
        <div class="stn-class-info">
            <h3>{{classInfo.name}}</h3>
            <p>{{classInfo.summary}}</p>
            <p><b>{{localize "STN.Creator.classSkills"}}:</b> {{classInfo.skills}}</p>
            {{#each classInfo.abilities}}<p><b>{{name}}.</b> {{note}}</p>{{/each}}
            {{#if classInfo.chooseAbility}}
            <h4>{{localize "STN.Creator.chooseAbility"}}</h4>
            <div class="stn-cards">
                {{#each classInfo.chooseAbility}}
                <button type="button" class="stn-card-btn {{#if selected}}selected{{/if}}" data-action="pickAbility" data-key="{{key}}">
                    <strong>{{name}}</strong><span>{{note}}</span>
                </button>
                {{/each}}
            </div>
            {{/if}}
        </div>
        {{/if}}

        <div class="stn-samples">
            <h3>{{localize "STN.Creator.samples"}}</h3>
            <p class="hint">{{localize "STN.Creator.samplesHint"}}</p>
            <div class="stn-chips">
                {{#each samples}}
                <button type="button" class="chip" data-action="sample" data-index="{{index}}">{{name}} <small>{{class}}</small></button>
                {{/each}}
            </div>
        </div>
        {{/if}}

        {{!-- ------------------------------------------------ STATS --}}
        {{#if (eq step "stats")}}
        <h2>{{localize "STN.Creator.stats"}}</h2>
        <p class="hint">{{localize "STN.Creator.statsHint" limit=statLimit}}</p>
        {{#each stats}}
        <div class="stn-stat-row">
            <div class="stn-stat-name"><strong>{{label}}</strong><span>{{text}}</span></div>
            <div class="stn-stat-control">
                <button type="button" data-action="stat" data-stat="{{key}}" data-delta="-1" {{#unless canDown}}disabled{{/unless}}>−</button>
                <span class="value">{{totalText}}</span>
                <button type="button" data-action="stat" data-stat="{{key}}" data-delta="1" {{#unless canUp}}disabled{{/unless}}>+</button>
            </div>
            <div class="stn-stat-note">
                {{#if free}}<span>{{localize "STN.Creator.freeFromClass" n=free}}</span>{{/if}}
            </div>
        </div>
        {{/each}}
        {{/if}}

        {{!-- ------------------------------------------------ SKILLS --}}
        {{#if (eq step "skills")}}
        <h2>{{localize "STN.Creator.skills"}}</h2>
        <p class="hint">{{localize "STN.Creator.skillsHint"}}</p>
        <p class="stn-slots">
            <span>{{localize "STN.Creator.classSlots"}} {{slots.classSkills.used}}/{{slots.classSkills.max}}</span>
            <span>{{localize "STN.Creator.commonSlots"}} {{slots.commonSkills.used}}/{{slots.commonSkills.max}}</span>
        </p>

        {{#if freeSkills.length}}
        <h3>{{localize "STN.Creator.freeSkills"}}</h3>
        <div class="stn-chips">
            {{#each freeSkills}}<span class="chip free">{{name}}</span>{{/each}}
        </div>
        {{/if}}

        {{#if freePicksNeeded}}
        <h3>{{localize "STN.Creator.freePicks" n=freePicksNeeded}}</h3>
        <div class="stn-chips">
            {{#each freePickList}}
            <button type="button" class="chip {{#if picked}}selected{{/if}}" data-action="toggleFreePick" data-key="{{key}}">{{name}}</button>
            {{/each}}
        </div>
        {{/if}}

        {{#if classSkills.length}}
        <h3>{{localize "STN.Creator.classSkillList"}}</h3>
        <div class="stn-list">
            {{#each classSkills}}
            <button type="button" class="stn-row {{#if selected}}selected{{/if}}" data-action="toggleSkill" data-key="{{key}}">
                <strong>{{name}}</strong><span>{{note}}</span><em>1</em>
            </button>
            {{/each}}
        </div>
        {{/if}}

        {{#if commonSkills.length}}
        <h3>{{localize "STN.Creator.commonSkillList"}}</h3>
        <div class="stn-list">
            {{#each commonSkills}}
            <button type="button" class="stn-row {{#if selected}}selected{{/if}}" data-action="toggleSkill" data-key="{{key}}">
                <strong>{{name}}</strong><span>{{note}}</span><em>1</em>
            </button>
            {{/each}}
        </div>
        {{/if}}

        {{#if canMaster}}
        <div class="form-group stn-mastery">
            <label>{{localize "STN.Creator.masteryTarget"}}</label>
            <select name="mastery">
                <option value="">—</option>
                {{#each masteryOptions}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
            </select>
        </div>
        {{/if}}

        {{#if lucky}}
        <div class="stn-lucky">
            <h3>{{localize "STN.Creator.lucky"}} ({{lucky.left}}/{{lucky.max}})</h3>
            <p class="hint">{{localize "STN.Creator.luckyHint"}}</p>
            <ul>
                {{#each lucky.trades}}
                <li>{{label}} <small>({{kind}})</small>
                    <button type="button" class="icon" data-action="lucky" data-index="{{index}}" title="{{localize 'STN.Creator.remove'}}"><i class="fa-solid fa-xmark"></i></button>
                </li>
                {{/each}}
            </ul>
            {{#if lucky.left}}
            <div class="form-fields">
                <select name="luckyPick" data-kind="skill">
                    <option value="">{{localize "STN.Creator.luckySkill"}}</option>
                    {{#each lucky.skills}}<option value="{{key}}">{{name}}</option>{{/each}}
                </select>
                <select name="luckyPick" data-kind="gear">
                    <option value="">{{localize "STN.Creator.luckyGear"}}</option>
                    {{#each lucky.gear}}<option value="{{key}}">{{name}}</option>{{/each}}
                </select>
            </div>
            {{/if}}
        </div>
        {{/if}}
        {{/if}}

        {{!-- ------------------------------------------------ TRAITS --}}
        {{#if (eq step "traits")}}
        <h2>{{localize "STN.Creator.traits"}}</h2>
        <p class="hint">{{localize "STN.Creator.traitsHint"}}</p>
        {{#each traitGroups}}
        <h3>{{label}}</h3>
        <div class="stn-list">
            {{#each traits}}
            <div class="stn-row {{#if selected}}selected{{/if}}">
                <strong>{{name}}</strong><span>{{note}}</span>
                <em>{{costText}}</em>
                <span class="stn-counter">
                    <button type="button" data-action="trait" data-key="{{key}}" data-delta="-1" {{#unless selected}}disabled{{/unless}}>−</button>
                    {{#if count}}<b>{{count}}</b>{{/if}}
                    <button type="button" data-action="trait" data-key="{{key}}" data-delta="1" {{#if selected}}{{#unless stack}}disabled{{/unless}}{{/if}}>+</button>
                </span>
            </div>
            {{/each}}
        </div>
        {{/each}}

        <h3>{{localize "STN.Creator.customTrait"}}</h3>
        <p class="hint">{{localize "STN.Creator.customTraitHint"}}</p>
        <ul>
            {{#each customTraits}}
            <li><b>{{name}}</b> ({{costText}}) {{note}}
                <button type="button" class="icon" data-action="removeTrait" data-index="{{index}}"><i class="fa-solid fa-xmark"></i></button>
            </li>
            {{/each}}
        </ul>
        <div class="form-fields stn-custom">
            <input type="text" name="customTraitName" placeholder="{{localize 'STN.Creator.customTraitName'}}">
            <input type="number" name="customTraitCost" value="1" min="-2" max="3">
            <input type="text" name="customTraitNote" placeholder="{{localize 'STN.Creator.customTraitNote'}}">
            <button type="button" data-action="addTrait"><i class="fa-solid fa-plus"></i> {{localize "STN.Creator.add"}}</button>
        </div>
        {{/if}}

        {{!-- ------------------------------------------------ GEAR --}}
        {{#if (eq step "gear")}}
        <h2>{{localize "STN.Creator.gear"}}</h2>
        <p class="hint">{{localize "STN.Creator.gearHint"}}</p>
        <p class="stn-slots"><span>{{localize "STN.Creator.gearSlots"}} {{slots.gear.used}}/{{slots.gear.max}}</span></p>
        {{#each gearGroups}}
        <h3>{{label}}</h3>
        <div class="stn-list">
            {{#each items}}
            <button type="button" class="stn-row {{#if selected}}selected{{/if}}" data-action="toggleGear" data-key="{{key}}">
                <strong>{{name}}</strong><span>{{note}}</span><em>{{cost}}</em>
            </button>
            {{/each}}
        </div>
        {{/each}}

        <h3>{{localize "STN.Creator.customGear"}}</h3>
        <ul>
            {{#each customGear}}
            <li>{{name}}
                <button type="button" class="icon" data-action="removeGear" data-index="{{index}}"><i class="fa-solid fa-xmark"></i></button>
            </li>
            {{/each}}
        </ul>
        <div class="form-fields stn-custom">
            <input type="text" name="customGearName" placeholder="{{localize 'STN.Creator.customGearName'}}">
            <button type="button" data-action="addGear"><i class="fa-solid fa-plus"></i> {{localize "STN.Creator.add"}}</button>
        </div>
        {{/if}}

        {{!-- ------------------------------------------------ REVIEW --}}
        {{#if (eq step "review")}}
        <h2>{{localize "STN.Creator.review"}}</h2>
        <div class="form-group">
            <label>{{localize "STN.Creator.name"}}</label>
            <div class="form-fields"><input type="text" name="charName" value="{{name}}" placeholder="{{review.className}}"></div>
        </div>
        <div class="stn-review">
            <div class="stn-vitals">
                <div><span>{{localize "STN.Life"}}</span><strong>{{review.life}}</strong></div>
                <div><span>{{localize "STN.DodgeValue"}}</span><strong>{{review.dv}}</strong></div>
                {{#each review.stats}}<div><span>{{label}}</span><strong>{{value}}</strong></div>{{/each}}
            </div>
            <dl>
                <dt>{{localize "STN.Class"}}</dt><dd>{{review.className}}</dd>
                {{#if review.abilities.length}}<dt>{{localize "STN.Creator.abilities"}}</dt><dd>{{#each review.abilities}}<span class="chip">{{this}}</span>{{/each}}</dd>{{/if}}
                <dt>{{localize "STN.Skills"}}</dt><dd>{{#each review.skills}}<span class="chip">{{this}}</span>{{else}}—{{/each}}</dd>
                <dt>{{localize "STN.Traits"}}</dt><dd>{{#each review.traits}}<span class="chip">{{this}}</span>{{else}}—{{/each}}</dd>
                <dt>{{localize "STN.Gear"}}</dt><dd>{{#each review.gear}}<span class="chip">{{this}}</span>{{else}}—{{/each}}</dd>
            </dl>
        </div>
        {{/if}}

        {{#if errors.length}}
        <ul class="stn-errors">{{#each errors}}<li>{{this}}</li>{{/each}}</ul>
        {{/if}}
        {{#if warnings.length}}
        <ul class="stn-warnings">{{#each warnings}}<li>{{this}}</li>{{/each}}</ul>
        {{/if}}
    </div>

    <footer class="stn-creator-foot">
        <button type="button" data-action="reset"><i class="fa-solid fa-rotate-left"></i> {{localize "STN.Creator.reset"}}</button>
        <span class="spacer"></span>
        {{#unless isFirst}}<button type="button" data-action="back"><i class="fa-solid fa-chevron-left"></i> {{localize "STN.Creator.back"}}</button>{{/unless}}
        {{#unless isLast}}<button type="button" class="primary" data-action="next" {{#unless canAdvance}}disabled{{/unless}}>{{localize "STN.Creator.next"}} <i class="fa-solid fa-chevron-right"></i></button>{{/unless}}
        {{#if isLast}}<button type="button" class="primary" data-action="create" {{#unless ok}}disabled{{/unless}}><i class="fa-solid fa-user-plus"></i> {{localize "STN.Creator.create"}}</button>{{/if}}
    </footer>
</section>
